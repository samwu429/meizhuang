# Example environment references only — put real values in private .env / Render / Neon.
# 仅为环境变量引用示例；真实值放入私有 .env / Render / Neon。

# Neon or other Postgres URL. Local smoke tests may use sqlite:///./meizhuang.db
# Neon 或其他 Postgres URL。本地冒烟测试可用 sqlite:///./meizhuang.db
DATABASE_URL=

ADMIN_PASSWORD=
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRE_HOURS=24

# Comma-separated frontend origins, e.g. https://meizhuang.onrender.com,http://localhost:5173
# 逗号分隔的前端来源
CORS_ORIGINS=http://localhost:5173

FRONTEND_URL=http://localhost:5173
